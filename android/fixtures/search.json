      "query": "magnet:?xt=urn:btih:abc"
    },
    {
      "name": "built in torrent",
      "query": "https://example.org/movie.torrent"
    },
    {
      "name": "built in no service",
      "query": "magnet:test",
      "services": {}
    },
    {
      "name": "optional unmatched capture",
      "query": "go",
      "config": {
        "actions": [
          {
            "matches": "^(go)( optional)?$",
            "name": "{0}:{1}:{2}",
            "service": "homeassistant.toggle",
            "service_data": {
              "value": "{2}"
            }
          }
        ]
      }
    },
    {
      "name": "replacement special dollars",
      "query": "send $$ $& $` $'",
      "config": {
        "actions": [
          {
            "matches": "^send (.*)$",
            "name": "a{1}z",
            "service": "homeassistant.toggle",
            "service_data": {
              "value": "before{1}after"
            }
          }
        ]
      }
    },
    {
      "name": "actions not truncated",
      "query": "toggle light.living_room",
      "config": {
        "max_results": 1,
        "actions": [
          {
            "matches": "^toggle (.+\\..+)",
            "name": "Toggle {1}",
            "service": "homeassistant.toggle",
