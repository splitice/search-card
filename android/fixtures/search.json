              "entity_id": "{1}",
              "nested": {
                "list": [
                  "{0}",
                  "{1}",
                  12,
                  true,
                  null
                ]
              },
              "repeat": "{1} {1}"
            }
          },
          {
            "matches": "^toggle (.+\\..+)",
